import requests

# Remplace bien par ton NOUVEAU lien entre les guillemets
url = "TON_NOUVEAU_WEBHOOK_ICI"

def test_webhook():
    payload = {"content": "Test depuis mon Mac !"}
    
    # On force la méthode POST
    try:
        r = requests.post(url, json=payload)
        if r.status_code == 204:
            print("✅ Ça marche ! Le message est sur Discord.")
        else:
            print(f"❌ Erreur {r.status_code} : {r.text}")
    except Exception as e:
        print(f"⚠️ Erreur système : {e}")

test_webhook()

